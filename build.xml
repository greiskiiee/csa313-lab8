<?xml version="1.0"?>
<project name="MeetingPlanner" basedir="." default="test">

    <property name="src.main" location="src/main/java"/>
    <property name="src.test" location="src/test/java"/>
    <property name="build" location="build"/>
    <property name="doc" location="javadoc"/>

    <!-- include all jars from lib on classpath -->
    <path id="project.class.path">
        <fileset dir="lib" includes="**/*.jar"/>
    </path>

    <target name="clean">
        <delete dir="${build}"/>
        <delete dir="${doc}"/>
    </target>

    <target name="compile">
        <mkdir dir="${build}"/>
        <javac srcdir="${src.main}" destdir="${build}" classpathref="project.class.path" includeantruntime="false"/>
    </target>

    <target name="compile-tests" depends="compile">
        <mkdir dir="${build}"/>
        <javac srcdir="${src.test}" destdir="${build}" classpathref="project.class.path" includeantruntime="false"/>
    </target>

    <target name="javadoc">
        <mkdir dir="${doc}"/>
        <javadoc sourcepath="${src.main}" destdir="${doc}" author="true" version="true"/>
    </target>

    <target name="test" depends="compile-tests">
        <junit printsummary="yes" haltonfailure="no" fork="yes">
            <classpath>
                <path refid="project.class.path"/>
                <pathelement path="${build}"/>
            </classpath>
            <batchtest todir="${build}/test-reports">
                <fileset dir="${build}">
                    <include name="**/*Test.class"/>
                </fileset>
            </batchtest>
        </junit>
    </target>
</project>