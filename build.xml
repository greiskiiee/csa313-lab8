<?xml version="1.0" encoding="UTF-8"?>
<project name="MeetingPlanner" basedir="." default="test">

    <!-- Define paths -->
    <property name="src.main" location="src/main/java"/>
    <property name="src.test" location="src/test/java"/>
    <property name="build" location="build/classes"/>
    <property name="build.test" location="build/test-classes"/>
    <property name="doc" location="javadoc"/>
    <property name="reports.dir" location="build/test-reports"/>
    <property name="jacoco.dir" location="build/jacoco"/>

    <!-- Include all jars from lib on classpath -->
    <path id="project.class.path">
        <fileset dir="lib" includes="**/*.jar"/>
    </path>

    <!-- Clean build + docs -->
    <target name="clean">
        <delete dir="${build}"/>
        <delete dir="${build.test}"/>
        <delete dir="${doc}"/>
        <delete dir="${reports.dir}"/>
        <delete dir="${jacoco.dir}"/>
    </target>

    <!-- Compile main source -->
    <target name="compile">
        <mkdir dir="${build}"/>
        <javac srcdir="${src.main}" destdir="${build}"
               classpathref="project.class.path"
               includeantruntime="false"/>
    </target>

    <!-- Compile tests -->
    <target name="compile-tests" depends="compile">
        <mkdir dir="${build.test}"/>
        <javac srcdir="${src.test}" destdir="${build.test}" includeantruntime="false">
            <classpath>
                <pathelement location="${build}"/>
                <path refid="project.class.path"/>
            </classpath>
        </javac>
    </target>

    <!-- Generate Javadoc -->
    <target name="javadoc">
        <mkdir dir="${doc}"/>
        <javadoc sourcepath="${src.main}" destdir="${doc}"
                 author="true" version="true" use="true"
                 classpathref="project.class.path">
            <doctitle><![CDATA[Meeting Planner API Documentation]]></doctitle>
        </javadoc>
    </target>

    <!-- Run JUnit tests -->
    <target name="test" depends="compile-tests">
        <mkdir dir="${reports.dir}"/>
        <junit printsummary="yes" haltonfailure="no" fork="yes">
            <classpath>
                <path refid="project.class.path"/>
                <pathelement path="${build}"/>
                <pathelement path="${build.test}"/>
            </classpath>

            <!-- Text and XML report -->
            <formatter type="plain"/>
            <formatter type="xml"/>

            <batchtest todir="${reports.dir}">
                <fileset dir="${src.test}">
                    <include name="**/*Test.java"/>
                </fileset>
            </batchtest>
        </junit>
    </target>

    <!-- Copy test reports to repo -->
    <target name="copy-test-reports" depends="test">
        <mkdir dir="reports"/>
        <copy todir="reports" flatten="true">
            <fileset dir="${reports.dir}" includes="*.txt, *.xml"/>
        </copy>
    </target>

    <!-- JaCoCo coverage target -->
    <taskdef uri="antlib:org.jacoco.ant" resource="org/jacoco/ant/antlib.xml" classpath="lib/jacocoant.jar"/>

    <target name="coverage" depends="compile-tests">
        <mkdir dir="${jacoco.dir}"/>
        <jacoco:coverage destfile="${jacoco.dir}/jacoco.exec">
            <junit printsummary="yes" haltonfailure="no" fork="true">
                <classpath>
                    <pathelement path="${build}"/>
                    <pathelement path="${build.test}"/>
                    <path refid="project.class.path"/>
                </classpath>
                <formatter type="xml"/>
                <batchtest todir="${reports.dir}">
                    <fileset dir="${src.test}">
                        <include name="**/*Test.java"/>
                    </fileset>
                </batchtest>
            </junit>
        </jacoco:coverage>

        <!-- Generate HTML, XML, CSV reports -->
        <jacoco:report>
            <executiondata>
                <file file="${jacoco.dir}/jacoco.exec"/>
            </executiondata>
            <structure name="MeetingPlanner">
                <classfiles>
                    <fileset dir="${build}"/>
                </classfiles>
                <sourcefiles encoding="UTF-8">
                    <fileset dir="${src.main}"/>
                </sourcefiles>
            </structure>
            <html destdir="${reports.dir}/jacoco-html"/>
            <xml destfile="${reports.dir}/jacoco.xml"/>
            <csv destfile="${reports.dir}/jacoco.csv"/>
        </jacoco:report>
    </target>

</project>
